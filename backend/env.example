# 灵鉴后端环境变量清单（复制为 .env 或在系统中导出）
# Python：建议使用 3.12（仓库根目录 .python-version，参见 backend/runtime.txt）
# —— 应用 ——
LINGJIAN_API_PREFIX=/api/v1
LINGJIAN_DEBUG=0
LINGJIAN_LOG_DIR=
LINGJIAN_LOG_LEVEL=INFO

# —— 数据库（默认 SQLite 开发库路径由配置推导；生产建议 MySQL）——
LINGJIAN_DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/lingjian?charset=utf8mb4
# 手动数据库备份输出目录（默认 backend/data/backups；SQLite 复制 .db，MySQL 需 PATH 中有 mysqldump）
# LINGJIAN_BACKUP_DIR=
LINGJIAN_REDIS_URL=redis://127.0.0.1:6379/0
LINGJIAN_REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# —— Celery ——
LINGJIAN_CELERY_BROKER=redis://127.0.0.1:6379/0
LINGJIAN_CELERY_RESULT=redis://127.0.0.1:6379/0

# —— JWT ——
LINGJIAN_JWT_SECRET=
LINGJIAN_JWT_ALGORITHM=HS256
LINGJIAN_JWT_ACCESS_MINUTES=60
LINGJIAN_JWT_REFRESH_DAYS=7

# —— 限流 / 上传 ——
LINGJIAN_RATE_LIMIT_PER_SECOND=10
LINGJIAN_MAX_UPLOAD_BYTES=20971520
LINGJIAN_MAX_TEXT_CHARS=20000
LINGJIAN_MAX_ZIP_ENTRIES=200

# —— 缓存 TTL（秒）——
LINGJIAN_CACHE_INFER_TTL=86400
LINGJIAN_CACHE_SESSION_TTL=86400

# —— Elasticsearch（留空则检索接口返回 503）——
LINGJIAN_ELASTICSEARCH_URL=http://127.0.0.1:9200

# —— 标准研判 infer_time 时区（IANA，如 Asia/Shanghai）——
LINGJIAN_INFER_TZ=Asia/Shanghai
# 启用 Qwen 等生成模型研判（需本地权重目录或 HuggingFace 模型 id）
# LINGJIAN_LLM_MODEL：留空则自动检测 models/qwen/Qwen2.5-3B-Instruct；也可填本地绝对路径或如 qwen/Qwen2.5-3B-Instruct
LINGJIAN_ENABLE_LLM=1
LINGJIAN_LLM_PROVIDER=local
LINGJIAN_LLM_MODEL=
LINGJIAN_BERT_CHECKPOINT=
LINGJIAN_LLM_MAX_NEW_TOKENS=384
# GPU 权重量化：8bit（bitsandbytes）或 16bit（fp16）；CPU 忽略。若 8bit 与当前 PyTorch 不兼容请改 16bit。
LINGJIAN_LLM_QUANTIZATION=8bit

# 外部 LLM API（OpenAI-compatible；当 LINGJIAN_LLM_PROVIDER=external 时启用）
# 阿里云百炼兼容模式可用：https://dashscope.aliyuncs.com/compatible-mode/v1
# LINGJIAN_EXTERNAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LINGJIAN_EXTERNAL_LLM_API_KEY=
# LINGJIAN_EXTERNAL_LLM_MODEL=qwen-plus
# LINGJIAN_EXTERNAL_LLM_TIMEOUT=120
# LINGJIAN_EXTERNAL_LLM_MAX_TOKENS=1024
# LINGJIAN_EXTERNAL_LLM_JSON_MODE=0

# —— 首次管理员（仅当库中无任何用户时生效）——
LINGJIAN_BOOTSTRAP_ADMIN=
LINGJIAN_BOOTSTRAP_PASSWORD=

# —— 脚本 e2e / analyze_once 调用需鉴权接口时 ——
LINGJIAN_ACCESS_TOKEN=
